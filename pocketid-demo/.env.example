# Copy to .env. The demo app serves the public origin, so keep APP_URL on 1411 (or your
# public HTTPS host when deployed). Pocket ID reads this file via docker compose, and the
# app (server.mjs) reads STATIC_API_KEY from it too.
APP_URL=http://localhost:1411
TRUST_PROXY=true

# Generate: openssl rand -base64 24
ENCRYPTION_KEY=replace-with-a-random-32-char-string

# Admin API key. Set it to allow open sign-up (any number of users create an account +
# passkey from the login page). Leave unset to fall back to Pocket ID's first-user setup.
# Generate: openssl rand -hex 24
STATIC_API_KEY=replace-with-a-random-key
