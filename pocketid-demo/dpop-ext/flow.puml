@startuml PasstheKeysDpopExt
title PasstheKeys - dpop extension (authenticator-named per-session key)
skinparam shadowing false
skinparam defaultFontName sans-serif
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 16
skinparam BoxPadding 12
actor "Victim" as V
box Relay Party domain
participant "Compromised\nfrontend" as VP
participant "Server /\nIdP" as AP
end box
participant "Authenticator\n(credential + SK)" as AU
participant "Attacker server" as S
actor "Attacker" as A

== Attacker arms, in its own tab of the site ==
A -> AP : Login begin
activate AP
AP --> A : passkeyToken + nonce
A -> S : nonce
activate S
== Victim tries to log in; signs the attacker's nonce ==
V -> VP : Login
VP -> S
S --> VP : nonce
VP -> AU : get(nonce, dpop)
AU -> AU : mint SK,\nput SK_pub in signed authData
AU --> VP : assertion (names SK_pub)
VP -> S : assertion
VP -> V : Fail
== Attacker finishes the login ==
S --> A : assertion
deactivate S
A -> AP : Login finish
deactivate AP
AP --> A : access_token (bound to SK)
== Attacker tries to use it, and is stuck ==
A -> AP : /api/me + SK proof?
note right of A : the proof must be signed by SK,\nsealed in the victim's authenticator
AP --> A : 401, no proof
@enduml
